{
  "name": "ngx-emoji-mart-next",
  "version": "0.0.0-placeholder",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "cpy": "cpy",
    "start": "ng serve",
    "build": "ng-packagr -p src/lib/picker/ng-package.json",
    "postbuild": "cpy README.md LICENSE dist",
    "build:integration:prod": "ng build --configuration production --no-progress",
    "serve:integration:static": "serve dist -s -l 4200 --cors",
    "build-data": "tsx scripts/build-data.ts",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:ci": "ng test --watch=false --code-coverage --no-progress --browsers=ChromeHeadlessCustom",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "vercel": "ng build --configuration vercel",
    "// - E2E": "E2E testing #requires pnpm run build:integration:prod",
    "e2e": "playwright test"
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/build-angular": "22.1.8",
    "@angular-eslint/builder": "16.0.3",
    "@angular-eslint/eslint-plugin": "16.0.3",
    "@angular-eslint/eslint-plugin-template": "16.0.3",
    "@angular-eslint/template-parser": "16.0.3",
    "@angular/cli": "22.1.8",
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/compiler-cli": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/language-service": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/platform-browser-dynamic": "22.1.7",
    "@ctrl/ngx-github-buttons": "9.0.0",
    "@playwright/test": "1.63.0",
    "@types/inflection": "1.13.0",
    "@types/jasmine": "4.3.2",
    "@types/node": "20.19.43",
    "@types/stringify-object": "4.0.2",
    "@typescript-eslint/eslint-plugin": "5.59.9",
    "@typescript-eslint/parser": "5.59.9",
    "core-js": "3.30.2",
    "cpy-cli": "4.2.0",
    "del-cli": "5.0.0",
    "emoji-datasource": "14.0.0",
    "emojilib": "3.0.10",
    "eslint": "8.42.0",
    "inflection": "2.0.1",
    "istanbul-lib-instrument": "6.0.3",
    "jasmine-core": "5.0.0",
    "karma": "6.4.2",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage-istanbul-reporter": "3.0.3",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "karma-mocha-reporter": "2.2.5",
    "ng-packagr": "22.1.1",
    "puppeteer": "20.5.0",
    "rxjs": "7.8.1",
    "serve": "14.2.0",
    "stringify-object": "5.0.0",
    "tailwindcss": "3.3.2",
    "tslib": "2.5.3",
    "tsx": "3.12.7",
    "typescript": "6.0.3",
    "zone.js": "0.15.1"
  },
  "repository": "arturovt/ngx-emoji-mart-next",
  "engines": {
    "node": ">= 14"
  }
}
